# Copy to /etc/topgun/topgun.env and replace example values before deployment.
ROASTML_MODEL=/opt/topgun/ML/models/current
TOPGUN_PORT=8080
TOPGUN_MAX_UPLOAD_BYTES=33554432
TOPGUN_DB_PATH=/var/lib/topgun/predictions.sqlite3

# HiveMQ Cloud MQTT broker
TOPGUN_MQTT_ENABLED=1
TOPGUN_MQTT_HOST=topguncoffee-a863a362.a02.usw2.aws.hivemq.cloud
TOPGUN_MQTT_PORT=8883
TOPGUN_MQTT_TOPIC=coffee/roast/result
TOPGUN_MQTT_TLS=1
# Set these on the Pi; never commit the actual password.
TOPGUN_MQTT_USERNAME=
TOPGUN_MQTT_PASSWORD=

# Set only when configuring hotspot.sh on the Pi.
TOPGUN_WIFI_IFACE=
TOPGUN_HOTSPOT_SSID=Topgun-Coffee
TOPGUN_HOTSPOT_PASSWORD=
